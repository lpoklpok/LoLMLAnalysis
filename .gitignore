.env
venv/
.venv/
__pycache__/
*.pyc
.DS_Store
*.ipynb_checkpoints
.idea/

# Raw OE CSVs (big, regenerated by refresh_oe_mirror.py)
data/raw/

# Top-level data CSVs (rarely useful; pipeline outputs live in processed/)
data/*.csv

# Local pipeline state / checkpoints — regenerated by feature_engineering.py
# and friends. Don't commit; keeps git status clean.
data/processed/*.csv
data/processed/*.json
data/processed/*.png

# Keep the live win-prob model artifact + its training frames — they're
# load-bearing for the Fly worker.
!data/processed/live_winprob/

.vercel
